{
  "manifest_version": 3,
  "name": "MGU Native Integration Prototype",
  "version": "0.0.1",
  "key": "",
  "description": "Original MIT-licensed local prototype; browser status only.",
  "permissions": [
    "tabs",
    "cookies",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "focus.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}